{
  "name": "nanoterm",
  "version": "5.0.0",
  "description": "Jetson에 특화된, 모든 리눅스 기기를 위한 SSH 데스크톱 클라이언트",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/main/*.test.mts src/main/packs/*.test.mts src/renderer/src/screens/*.test.mts",
    "dist": "npm run licenses && npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run licenses && npm run build && electron-builder --linux --publish never",
    "dist:linux:arm64": "npm run licenses && npm run build && electron-builder --linux --arm64 --config electron-builder.arm64.cjs --publish never",
    "licenses": "node scripts/licenses.mjs"
  },
  "keywords": [],
  "author": "Dawnilove",
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@fontsource/black-han-sans": "^5.3.0",
    "@fontsource/gowun-batang": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/jua": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@novnc/novnc": "^1.7.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "monaco-editor": "^0.57.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "productName": "JetDeck",
  "homepage": "https://github.com/Dawnilove/JetDeck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dawnilove/JetDeck.git"
  },
  "bugs": {
    "url": "https://github.com/Dawnilove/JetDeck/issues"
  },
  "private": true,
  "build": {
    "appId": "io.github.dawnilove.jetdeck",
    "productName": "JetDeck",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "themes/**",
      "resources/**",
      "package.json",
      "!node_modules/@serialport/bindings-cpp/prebuilds/{android-arm,android-arm64,darwin-x64+arm64,linux-arm,linux-arm64,win32-arm64,win32-ia32}/**"
    ],
    "asar": true,
    "artifactName": "JetDeck-Setup-${version}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "JetDeck",
      "uninstallDisplayName": "JetDeck"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Dawnilove",
        "repo": "JetDeck",
        "releaseType": "release"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "portable": {
      "artifactName": "JetDeck-${version}-portable.${ext}"
    },
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "compression": "maximum",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Development",
      "executableName": "jetdeck",
      "artifactName": "JetDeck-${version}-x86_64.${ext}"
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "build/THIRD_PARTY_LICENSES.txt",
        "to": "THIRD_PARTY_LICENSES.txt"
      }
    ]
  }
}
