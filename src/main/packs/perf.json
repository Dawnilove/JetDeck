{
  "id": "perf",
  "format": 1,
  "version": "5.2.0",
  "minApp": "5.2.0",
  "name": { "ko": "모니터·성능", "en": "Monitor and performance" },
  "author": "JetDeck",
  "license": "Apache-2.0",
  "plugins": [
    {
      "id": "perf-hw",
      "title": { "ko": "성능·장치", "en": "Performance & devices" },
      "desc": { "ko": "Jetson의 클럭·팬·I2C·USB·GPIO를 확인해요. 스캔 한 가지만 확인창을 거치고 나머지는 보기만 해요.", "en": "Check Jetson clocks, fan, I2C, USB and GPIO. Only the bus scan asks first; the rest is view-only." },
      "actions": [
        {
          "id": "clocks",
          "label": { "ko": "클럭 상태", "en": "Clock status" },
          "desc": { "ko": "jetson_clocks --show — CPU·GPU·EMC 클럭 설정이에요. 관리자 권한(sudo)이 필요해서 비밀번호를 물을 수 있어요. 보기만 해요.", "en": "jetson_clocks --show — CPU, GPU and EMC clock settings. Needs admin rights (sudo), so it may ask for a password. View only." },
          "cmd": "jetson_clocks --show",
          "sudo": true,
          "risk": "change",
          "confirm": { "ko": "클럭 설정을 읽기만 해요. 관리자 권한이 필요해서 비밀번호를 물을 수 있어요.", "en": "Only reads the clock settings. It needs admin rights, so it may ask for a password." },
          "when": "jetson",
          "display": { "type": "text" }
        },
        {
          "id": "fan",
          "label": { "ko": "팬 상태", "en": "Fan status" },
          "desc": { "ko": "팬 속도(PWM) 값을 읽어요. 팬 경로는 기종마다 달라서 없을 수 있어요.", "en": "Reads the fan speed (PWM) value. The fan path differs by model, so it may be missing." },
          "cmd": "grep -H . /sys/devices/pwm-fan/target_pwm /sys/devices/platform/pwm-fan/hwmon/hwmon*/pwm1 /sys/class/hwmon/hwmon*/pwm1 2>/dev/null",
          "risk": "read",
          "when": "jetson",
          "display": { "type": "table", "match": "^(.+):(\\d+)$", "columns": [{ "ko": "파일", "en": "File" }, { "ko": "값 (0~255)", "en": "Value (0-255)" }], "empty": { "ko": "팬 값을 찾지 못했어요. 이 기종은 팬 경로가 달라요.", "en": "No fan value found. This model uses a different fan path." } }
        },
        {
          "id": "i2c-list",
          "label": { "ko": "I2C 버스 목록", "en": "I2C bus list" },
          "cmd": "i2cdetect -l",
          "risk": "read",
          "when": "jetson",
          "display": { "type": "table", "split": "tab", "columns": [{ "ko": "버스", "en": "Bus" }, { "ko": "종류", "en": "Type" }, { "ko": "이름", "en": "Name" }, { "ko": "어댑터", "en": "Adapter" }], "empty": { "ko": "I2C 버스가 없거나 i2c-tools가 없어요.", "en": "No I2C bus, or i2c-tools is missing." } }
        },
        {
          "id": "i2c-scan",
          "label": { "ko": "I2C 버스 스캔", "en": "Scan I2C bus" },
          "desc": { "ko": "고른 버스의 주소를 하나씩 읽어 장치를 찾아요.", "en": "Probes each address on the chosen bus to find devices." },
          "cmd": "i2cdetect -y -r {bus}",
          "sudo": true,
          "risk": "change",
          "when": "jetson",
          "confirm": { "ko": "버스의 모든 주소를 읽어 봐요. 드물게 일부 장치가 이상 반응할 수 있어요. 센서가 연결된 버스를 고르세요.", "en": "Every address on the bus is probed. Rarely, some devices react oddly. Pick the bus your sensor is on." },
          "params": [
            { "name": "bus", "label": { "ko": "버스", "en": "Bus" }, "choices": [
              { "value": "0", "label": { "ko": "버스 0", "en": "Bus 0" } },
              { "value": "1", "label": { "ko": "버스 1", "en": "Bus 1" } },
              { "value": "2", "label": { "ko": "버스 2", "en": "Bus 2" } },
              { "value": "4", "label": { "ko": "버스 4", "en": "Bus 4" } },
              { "value": "5", "label": { "ko": "버스 5", "en": "Bus 5" } },
              { "value": "7", "label": { "ko": "버스 7", "en": "Bus 7" } }
            ] }
          ],
          "display": { "type": "text" }
        },
        {
          "id": "usb",
          "label": { "ko": "USB 장치 목록", "en": "USB devices" },
          "cmd": "lsusb",
          "risk": "read",
          "when": "jetson",
          "auto": true,
          "display": { "type": "table", "match": "^Bus (\\d+) Device (\\d+): ID (\\S+) (.*)$", "columns": [{ "ko": "버스", "en": "Bus" }, { "ko": "장치", "en": "Device" }, { "ko": "ID", "en": "ID" }, { "ko": "이름", "en": "Name" }], "empty": { "ko": "USB 장치가 없어요.", "en": "No USB devices." } }
        },
        {
          "id": "gpio",
          "label": { "ko": "GPIO 정보", "en": "GPIO info" },
          "desc": { "ko": "GPIO 칩 장치 파일(/dev/gpiochip*) 목록이에요. 핀의 현재 값은 읽지 않아요.", "en": "List of GPIO chip device files (/dev/gpiochip*). Pin values are not read." },
          "cmd": "ls /dev/gpiochip* 2>/dev/null",
          "risk": "read",
          "when": "jetson",
          "display": { "type": "table", "match": "^(/dev/gpiochip\\d+)$", "columns": [{ "ko": "GPIO 칩", "en": "GPIO chip" }], "empty": { "ko": "GPIO 정보를 읽지 못했어요.", "en": "Could not read GPIO info." } }
        }
      ]
    },
    {
      "id": "perf-graph",
      "title": { "ko": "센서 그래프", "en": "Sensor charts" },
      "desc": { "ko": "온도·메모리·부하·GPU·팬 값을 시간에 따라 그려요. 시작을 누를 때만 읽고, 읽기만 해요.", "en": "Plots temperature, memory, load, GPU and fan values over time. Reads only when you press Start." },
      "actions": [
        {
          "id": "temp-chart",
          "label": { "ko": "온도 그래프", "en": "Temperature chart" },
          "desc": { "ko": "열 센서(thermal zone)마다 선 하나로 그려요. 값이 없는 센서는 건너뛰어요.", "en": "One line per thermal zone. Zones without data are skipped." },
          "cmd": "grep -H . /sys/class/thermal/thermal_zone*/temp 2>/dev/null || true",
          "risk": "read",
          "display": { "type": "chart", "every": 2, "unit": "℃", "min": 0, "max": 100, "match": "thermal_zone(\\d+)/temp:(-?\\d+)$", "perLine": { "label": { "ko": "존 {1}", "en": "Zone {1}" }, "value": 2, "scale": 0.001 } }
        },
        {
          "id": "mem-chart",
          "label": { "ko": "메모리 그래프", "en": "Memory chart" },
          "desc": { "ko": "전체 메모리와 쓸 수 있는 메모리(MemAvailable)를 MB로 그려요.", "en": "Total and available memory (MemAvailable) in MB." },
          "cmd": "grep -E '^(MemTotal|MemAvailable):' /proc/meminfo",
          "risk": "read",
          "display": { "type": "chart", "every": 2, "unit": "MB", "min": 0, "match": "^(\\w+):\\s+(\\d+) kB$", "series": [
            { "label": { "ko": "전체", "en": "Total" }, "key": "MemTotal", "scale": 0.0009765625 },
            { "label": { "ko": "쓸 수 있음", "en": "Available" }, "key": "MemAvailable", "scale": 0.0009765625 }
          ] }
        },
        {
          "id": "load-chart",
          "label": { "ko": "부하 평균 그래프", "en": "Load average chart" },
          "desc": { "ko": "1분·5분·15분 부하 평균이에요. 코어 수와 비교해서 보세요.", "en": "The 1, 5 and 15 minute load averages. Compare them with the core count." },
          "cmd": "cat /proc/loadavg",
          "risk": "read",
          "display": { "type": "chart", "every": 2, "min": 0, "split": "ws", "series": [
            { "label": { "ko": "1분", "en": "1 min" }, "col": 1 },
            { "label": { "ko": "5분", "en": "5 min" }, "col": 2 },
            { "label": { "ko": "15분", "en": "15 min" }, "col": 3 }
          ] }
        },
        {
          "id": "gpu-chart",
          "label": { "ko": "GPU 사용률 그래프", "en": "GPU load chart" },
          "desc": { "ko": "GPU 사용률(%)이에요. 이 경로가 없는 기종에서는 숫자가 안 나와요.", "en": "GPU load in percent. Models without this path show no numbers." },
          "cmd": "cat /sys/devices/platform/gpu.0/load",
          "risk": "read",
          "when": "jetson",
          "display": { "type": "chart", "every": 1, "unit": "%", "min": 0, "max": 100, "split": "ws", "series": [
            { "label": { "ko": "GPU", "en": "GPU" }, "col": 1, "scale": 0.1 }
          ] }
        },
        {
          "id": "fan-chart",
          "label": { "ko": "팬 속도 그래프", "en": "Fan speed chart" },
          "desc": { "ko": "팬 속도(PWM 0~255)예요. 팬 경로가 다른 기종에서는 숫자가 안 나와요.", "en": "Fan speed (PWM 0-255). Models with another fan path show no numbers." },
          "cmd": "grep -H . /sys/class/hwmon/hwmon*/pwm1 2>/dev/null || true",
          "risk": "read",
          "when": "jetson",
          "display": { "type": "chart", "every": 2, "min": 0, "max": 255, "match": "hwmon(\\d+)/pwm1:(\\d+)$", "perLine": { "label": { "ko": "팬 {1}", "en": "Fan {1}" }, "value": 2 } }
        }
      ]
    }
  ]
}
