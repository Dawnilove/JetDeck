{
  "id": "device",
  "format": 1,
  "version": "5.0.0",
  "name": { "ko": "기기 관리", "en": "Device management" },
  "author": "JetDeck",
  "license": "Apache-2.0",
  "plugins": [
    {
      "id": "apt",
      "group": "manage",
      "title": { "ko": "apt 업데이트", "en": "apt updates" },
      "desc": { "ko": "설치된 패키지 중 새 버전이 있는 것을 보고 업데이트해요. 설치는 확인창을 거쳐요.", "en": "See which installed packages have newer versions and update them. Installing always asks first." },
      "actions": [
        {
          "id": "apt-check",
          "label": { "ko": "업데이트 확인", "en": "Check for updates" },
          "desc": { "ko": "지금 받을 수 있는 업데이트 목록이에요. 목록이 오래됐으면 먼저 \"목록 새로고침\"을 하세요.", "en": "Updates available right now. If the list looks stale, refresh it first." },
          "cmd": "apt list --upgradable 2>/dev/null",
          "risk": "read",
          "auto": true,
          "display": {
            "type": "table",
            "match": "^(\\S+)/(\\S+) (\\S+) (\\S+) \\[upgradable from: (.+)\\]$",
            "columns": [
              { "ko": "패키지", "en": "Package" },
              { "ko": "저장소", "en": "Repository" },
              { "ko": "새 버전", "en": "New version" },
              { "ko": "구조", "en": "Arch" },
              { "ko": "현재 버전", "en": "Current version" }
            ],
            "empty": { "ko": "업데이트할 패키지가 없어요.", "en": "Everything is up to date." }
          }
        },
        {
          "id": "apt-update",
          "label": { "ko": "목록 새로고침 (apt update)", "en": "Refresh lists (apt update)" },
          "desc": { "ko": "패키지 목록만 새로 받아요. 설치되는 것은 없어요.", "en": "Only downloads fresh package lists. Nothing gets installed." },
          "cmd": "apt-get update",
          "sudo": true,
          "risk": "change",
          "confirm": { "ko": "패키지 목록을 새로 받아요. 설치되는 것은 없어요.", "en": "This downloads fresh package lists. Nothing gets installed." },
          "timeout": 300,
          "display": { "type": "text" }
        },
        {
          "id": "apt-upgrade",
          "label": { "ko": "모두 업그레이드 (apt upgrade)", "en": "Upgrade all (apt upgrade)" },
          "desc": { "ko": "목록에 있는 패키지를 모두 새 버전으로 바꿔요. 몇 분 걸릴 수 있어요.", "en": "Replaces every listed package with its newer version. This can take a few minutes." },
          "cmd": "apt-get -y upgrade",
          "sudo": true,
          "risk": "danger",
          "preview": "apt-get -s upgrade 2>&1 | grep -E '^(Inst|Remv|Conf)' | head -200",
          "confirm": { "ko": "아래 패키지를 설치·교체해요. 몇 분 걸리고, 드라이버나 커널이 바뀌면 재부팅이 필요할 수 있어요. 끝날 때까지 앱을 닫지 마세요.", "en": "The packages below will be installed or replaced. It takes a few minutes, and a reboot may be needed if drivers or the kernel change. Keep the app open until it finishes." },
          "timeout": 1800,
          "display": { "type": "text" }
        }
      ]
    },
    {
      "id": "disk",
      "group": "manage",
      "title": { "ko": "디스크", "en": "Disk" },
      "desc": { "ko": "어디에 공간이 쓰였는지 보고, 안전하게 줄일 수 있는 것만 정리해요. 정리는 미리보기를 본 뒤에만 실행돼요.", "en": "See where space is used and clean up only what is safe to remove. Cleanup runs only after you have seen the preview." },
      "actions": [
        {
          "id": "disk-df",
          "label": { "ko": "디스크 사용량", "en": "Disk usage" },
          "cmd": "df -hP -x tmpfs -x devtmpfs -x squashfs -x overlay",
          "risk": "read",
          "auto": true,
          "display": {
            "type": "table",
            "split": "ws",
            "skip": 1,
            "columns": [
              { "ko": "장치", "en": "Device" },
              { "ko": "크기", "en": "Size" },
              { "ko": "사용", "en": "Used" },
              { "ko": "남음", "en": "Free" },
              { "ko": "사용률", "en": "Use" },
              { "ko": "위치", "en": "Mounted on" }
            ],
            "empty": { "ko": "디스크 정보를 읽지 못했어요.", "en": "Could not read disk info." }
          }
        },
        {
          "id": "disk-du",
          "label": { "ko": "큰 폴더 보기", "en": "Largest folders" },
          "desc": { "ko": "고른 위치 바로 아래에서 큰 폴더 15개예요. 보기만 하고 아무것도 지우지 않아요. 큰 위치는 1분 넘게 걸릴 수 있어요.", "en": "The 15 largest entries directly under the chosen place. View only — nothing is deleted. Large places can take over a minute." },
          "cmd": "du -xh --max-depth=1 {dir} 2>/dev/null | sort -rh | head -15",
          "risk": "read",
          "timeout": 120,
          "params": [
            {
              "name": "dir",
              "label": { "ko": "위치", "en": "Location" },
              "choices": [
                { "value": "~", "label": { "ko": "내 홈 폴더", "en": "My home folder" } },
                { "value": "/home", "label": { "ko": "/home (모든 사용자)", "en": "/home (all users)" } },
                { "value": "/var", "label": { "ko": "/var (로그·캐시)", "en": "/var (logs, caches)" } },
                { "value": "/opt", "label": { "ko": "/opt", "en": "/opt" } },
                { "value": "/", "label": { "ko": "/ (전체, 오래 걸림)", "en": "/ (everything, slow)" } }
              ]
            }
          ],
          "display": {
            "type": "table",
            "match": "^(\\S+)\\t(.+)$",
            "columns": [{ "ko": "크기", "en": "Size" }, { "ko": "폴더", "en": "Folder" }],
            "empty": { "ko": "읽을 수 있는 폴더가 없어요.", "en": "No readable folders." }
          }
        },
        {
          "id": "apt-clean",
          "label": { "ko": "apt 내려받은 파일 비우기", "en": "Clear downloaded apt files" },
          "desc": { "ko": "업데이트 때 내려받아 둔 설치 파일(.deb)을 지워요. 설치된 프로그램은 그대로예요.", "en": "Removes cached .deb files left over from updates. Installed programs are untouched." },
          "cmd": "apt-get clean",
          "sudo": true,
          "risk": "change",
          "preview": "du -sh /var/cache/apt/archives 2>&1",
          "confirm": { "ko": "아래 크기만큼의 내려받은 설치 파일을 지워요. 설치된 프로그램은 지워지지 않고, 필요하면 다시 내려받아요.", "en": "The downloaded package files below will be deleted. Installed programs stay, and files are downloaded again if needed." },
          "display": { "type": "text" }
        },
        {
          "id": "apt-autoremove",
          "label": { "ko": "안 쓰는 패키지 정리", "en": "Remove unused packages" },
          "desc": { "ko": "다른 프로그램이 더는 필요로 하지 않는 패키지(예전 커널·라이브러리 등)를 지워요.", "en": "Removes packages no other program needs any more (old kernels, libraries and so on)." },
          "cmd": "apt-get -y autoremove",
          "sudo": true,
          "risk": "danger",
          "preview": "apt-get -s autoremove 2>&1 | grep -E '^Remv' | head -100",
          "confirm": { "ko": "아래 패키지를 삭제해요. 직접 설치한 프로그램이 목록에 있으면 취소하세요.", "en": "The packages below will be removed. Cancel if you see a program you installed on purpose." },
          "timeout": 600,
          "display": { "type": "text" }
        },
        {
          "id": "journal-vacuum",
          "label": { "ko": "시스템 로그 줄이기 (200MB까지)", "en": "Shrink system logs (to 200 MB)" },
          "desc": { "ko": "journalctl 로그가 200MB를 넘으면 오래된 것부터 지워요. 최근 로그는 남아요.", "en": "If journal logs exceed 200 MB, the oldest entries are removed first. Recent logs stay." },
          "cmd": "journalctl --vacuum-size=200M",
          "sudo": true,
          "risk": "change",
          "preview": "journalctl --disk-usage 2>&1",
          "confirm": { "ko": "현재 로그 용량은 아래와 같아요. 200MB를 넘는 오래된 로그가 지워져요.", "en": "Current log size is shown below. Old logs beyond 200 MB will be deleted." },
          "display": { "type": "text" }
        }
      ]
    },
    {
      "id": "power",
      "group": "manage",
      "title": { "ko": "전원·부팅", "en": "Power and boot" },
      "desc": { "ko": "부팅 방식과 재부팅·종료 예약을 다뤄요. 예약은 언제든 취소할 수 있고, 부팅 방식은 다시 바꿀 수 있어요.", "en": "Manage how the Device boots and schedule a reboot or shutdown. Schedules can be cancelled and the boot mode can be changed back anytime." },
      "actions": [
        {
          "id": "pwr-status",
          "label": { "ko": "현재 상태", "en": "Current status" },
          "cmd": "echo \"target=$(systemctl get-default 2>/dev/null)\"; echo \"up=$(uptime -p)\"; echo \"since=$(uptime -s)\"; if [ -f /var/run/reboot-required ]; then echo reboot=yes; else echo reboot=no; fi; if [ -f /run/systemd/shutdown/scheduled ]; then s=$(grep -m1 '^USEC=' /run/systemd/shutdown/scheduled | cut -d= -f2); echo \"scheduled=$(date -d @$((s/1000000)) '+%F %T') $(grep -m1 '^MODE=' /run/systemd/shutdown/scheduled | cut -d= -f2)\"; else echo scheduled=none; fi",
          "risk": "read",
          "auto": true,
          "display": {
            "type": "table",
            "match": "^(\\w+)=(.*)$",
            "columns": [{ "ko": "항목", "en": "Item" }, { "ko": "값", "en": "Value" }],
            "labels": {
              "target": { "ko": "부팅 방식", "en": "Boot mode" },
              "up": { "ko": "켜져 있던 시간", "en": "Uptime" },
              "since": { "ko": "켜진 시각", "en": "Booted at" },
              "reboot": { "ko": "재부팅 필요 (업데이트 적용 대기)", "en": "Reboot needed (pending update)" },
              "scheduled": { "ko": "예약된 재부팅·종료", "en": "Scheduled reboot/shutdown" }
            }
          }
        },
        {
          "id": "pwr-mode",
          "label": { "ko": "전원 모드 (현재값)", "en": "Power mode (current)" },
          "desc": { "ko": "nvpmodel -q — 지금 적용된 Jetson 전원 모드예요. 바꾸는 건 모니터 화면에서 해요.", "en": "nvpmodel -q — the Jetson power mode in use. Change it from the Monitor screen." },
          "cmd": "nvpmodel -q 2>&1",
          "risk": "read",
          "when": "jetson",
          "auto": true,
          "display": { "type": "text" }
        },
        {
          "id": "pwr-target",
          "label": { "ko": "부팅 방식 바꾸기", "en": "Change boot mode" },
          "desc": { "ko": "graphical은 화면(데스크톱)을 켜고, multi-user는 화면 없이 서버 모드로 켜요. 다음 부팅부터 적용돼요.", "en": "graphical boots to the desktop; multi-user boots without a screen (server mode). Applies from the next boot." },
          "cmd": "systemctl set-default {target}",
          "sudo": true,
          "risk": "change",
          "params": [
            {
              "name": "target",
              "label": { "ko": "방식", "en": "Mode" },
              "choices": [
                { "value": "graphical.target", "label": { "ko": "화면 있음 (graphical)", "en": "With desktop (graphical)" } },
                { "value": "multi-user.target", "label": { "ko": "화면 없음 (multi-user)", "en": "No desktop (multi-user)" } }
              ]
            }
          ],
          "confirm": { "ko": "다음 부팅부터 적용돼요. 지금 화면이 꺼지거나 연결이 끊기지는 않아요. 되돌리려면 이곳에서 다시 고르세요.", "en": "Applies from the next boot. Nothing changes right now and your connection stays up. To undo, pick the other mode here." },
          "display": { "type": "text" }
        },
        {
          "id": "pwr-sched-reboot",
          "label": { "ko": "재부팅 예약", "en": "Schedule reboot" },
          "cmd": "shutdown -r +{min}",
          "sudo": true,
          "risk": "danger",
          "params": [
            {
              "name": "min",
              "label": { "ko": "몇 분 뒤", "en": "In" },
              "choices": [
                { "value": "5", "label": { "ko": "5분", "en": "5 min" } },
                { "value": "30", "label": { "ko": "30분", "en": "30 min" } },
                { "value": "60", "label": { "ko": "1시간", "en": "1 hour" } }
              ]
            }
          ],
          "confirm": { "ko": "고른 시간이 지나면 Device가 재부팅돼요. 그때 이 연결이 끊겨요. 예약은 \"예약 취소\"로 없앨 수 있어요.", "en": "The Device will reboot after the chosen time and this connection will drop. You can remove the schedule with \"Cancel schedule\"." },
          "display": { "type": "text" }
        },
        {
          "id": "pwr-sched-off",
          "label": { "ko": "종료 예약", "en": "Schedule shutdown" },
          "cmd": "shutdown -P +{min}",
          "sudo": true,
          "risk": "danger",
          "params": [
            {
              "name": "min",
              "label": { "ko": "몇 분 뒤", "en": "In" },
              "choices": [
                { "value": "5", "label": { "ko": "5분", "en": "5 min" } },
                { "value": "30", "label": { "ko": "30분", "en": "30 min" } },
                { "value": "60", "label": { "ko": "1시간", "en": "1 hour" } }
              ]
            }
          ],
          "confirm": { "ko": "고른 시간이 지나면 Device가 꺼져요. 다시 켜려면 전원을 직접 눌러야 해요. 예약은 \"예약 취소\"로 없앨 수 있어요.", "en": "The Device will power off after the chosen time. You will need to press its power button to turn it on again. You can remove the schedule with \"Cancel schedule\"." },
          "display": { "type": "text" }
        },
        {
          "id": "pwr-cancel",
          "label": { "ko": "예약 취소", "en": "Cancel schedule" },
          "desc": { "ko": "걸어 둔 재부팅·종료 예약을 없애요.", "en": "Removes a scheduled reboot or shutdown." },
          "cmd": "shutdown -c",
          "sudo": true,
          "risk": "change",
          "confirm": { "ko": "예약된 재부팅·종료를 취소해요.", "en": "Cancels the scheduled reboot or shutdown." },
          "display": { "type": "text" }
        },
        {
          "id": "pwr-reboot",
          "label": { "ko": "지금 재부팅", "en": "Reboot now" },
          "cmd": "reboot",
          "sudo": true,
          "risk": "danger",
          "disconnects": true,
          "confirm": { "ko": "Device를 지금 재부팅해요. 연결이 끊기고, 다시 켜질 때까지 쓸 수 없어요.", "en": "The Device reboots right now. The connection drops and it is unavailable until it is back up." },
          "display": { "type": "text" }
        },
        {
          "id": "pwr-off",
          "label": { "ko": "지금 종료", "en": "Shut down now" },
          "cmd": "poweroff",
          "sudo": true,
          "risk": "danger",
          "disconnects": true,
          "confirm": { "ko": "Device를 지금 꺼요. 다시 켜려면 전원을 직접 눌러야 해요.", "en": "The Device powers off right now. You will need to press its power button to turn it on again." },
          "display": { "type": "text" }
        }
      ]
    },
    {
      "id": "logs",
      "group": "manage",
      "title": { "ko": "로그 보기", "en": "Logs" },
      "desc": { "ko": "systemd 저널(journalctl)에서 서비스별 최근 로그를 읽어요. 보기만 해요.", "en": "Reads recent logs per service from the systemd journal (journalctl). View only." },
      "actions": [
        {
          "id": "log-view",
          "label": { "ko": "서비스 로그", "en": "Service log" },
          "cmd": "journalctl --no-pager -u {unit} -n {lines} -p {level}",
          "risk": "read",
          "timeout": 60,
          "params": [
            { "name": "unit", "label": { "ko": "서비스", "en": "Service" }, "choices": [
              { "value": "ssh", "label": { "ko": "ssh (원격 접속)", "en": "ssh (remote login)" } },
              { "value": "NetworkManager", "label": { "ko": "NetworkManager (네트워크)", "en": "NetworkManager (network)" } },
              { "value": "docker", "label": { "ko": "docker", "en": "docker" } },
              { "value": "systemd-resolved", "label": { "ko": "systemd-resolved (DNS)", "en": "systemd-resolved (DNS)" } },
              { "value": "cron", "label": { "ko": "cron (예약 작업)", "en": "cron (scheduled jobs)" } }
            ] },
            { "name": "lines", "label": { "ko": "줄 수", "en": "Lines" }, "choices": [
              { "value": "50", "label": { "ko": "50줄", "en": "50 lines" } },
              { "value": "200", "label": { "ko": "200줄", "en": "200 lines" } }
            ] },
            { "name": "level", "label": { "ko": "범위", "en": "Scope" }, "choices": [
              { "value": "debug", "label": { "ko": "전체", "en": "All" } },
              { "value": "err", "label": { "ko": "오류만", "en": "Errors only" } }
            ] }
          ],
          "display": { "type": "text" }
        },
        {
          "id": "log-follow",
          "label": { "ko": "서비스 로그 따라 보기 (실시간)", "en": "Follow service log (live)" },
          "desc": { "ko": "journalctl -f — 새 로그가 생길 때마다 이어서 보여 줘요. 멈춤을 누르거나 화면을 나가면 끝나요.", "en": "journalctl -f — keeps showing new log lines as they appear. Stop it, or leave this screen, to end it." },
          "mode": "stream",
          "cmd": "journalctl --no-pager -u {unit} -n {lines} -f",
          "risk": "read",
          "timeout": 900,
          "fields": [
            { "name": "unit", "label": { "ko": "서비스", "en": "Service" }, "type": "select", "choices": [
              { "value": "ssh", "label": { "ko": "ssh (원격 접속)", "en": "ssh (remote login)" } },
              { "value": "NetworkManager", "label": { "ko": "NetworkManager (네트워크)", "en": "NetworkManager (network)" } },
              { "value": "docker", "label": { "ko": "docker", "en": "docker" } },
              { "value": "systemd-resolved", "label": { "ko": "systemd-resolved (DNS)", "en": "systemd-resolved (DNS)" } },
              { "value": "cron", "label": { "ko": "cron (예약 작업)", "en": "cron (scheduled jobs)" } }
            ] },
            { "name": "lines", "label": { "ko": "처음 줄 수", "en": "First lines" }, "type": "int", "min": 10, "max": 500, "default": "50" }
          ],
          "display": { "type": "log", "maxLines": 1000 }
        }
      ]
    }
  ]
}
