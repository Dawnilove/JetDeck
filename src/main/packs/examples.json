{
  "$schema": "https://dawnilove.github.io/JetDeck/plugins/jdpack.schema.json",
  "$comment": "Example pack: copy this file, change the id (the name examples is reserved), the paths (~/my-project) and names, and install the copy. 예제 팩: 이 파일을 복사해 id(examples는 예약어), 경로(~/my-project)와 이름을 바꿔 쓰세요.",
  "id": "examples",
  "format": 1,
  "version": "5.3.0",
  "minApp": "5.3.0",
  "name": { "ko": "예제 모음", "en": "Examples" },
  "desc": { "ko": "복사해서 고쳐 쓰는 템플릿이에요. 경로는 ~/my-project 처럼 내 것으로 바꾸세요.", "en": "Templates to copy and edit. Change paths such as ~/my-project to your own." },
  "author": "JetDeck",
  "license": "Apache-2.0",
  "plugins": [
    {
      "id": "my-project",
      "title": { "ko": "내 프로젝트", "en": "My project" },
      "desc": { "ko": "터미널에 명령을 입력하는 템플릿이에요. ~/my-project 를 내 프로젝트 폴더로 바꾸세요.", "en": "Templates that type commands into the terminal. Replace ~/my-project with your project folder." },
      "actions": [
        {
          "id": "goto",
          "$comment": "Change ~/my-project to your folder. 폴더 경로를 내 것으로 바꾸세요.",
          "label": { "ko": "프로젝트 폴더로 이동", "en": "Go to project folder" },
          "mode": "terminal",
          "cmd": "cd ~/my-project",
          "risk": "change",
          "confirm": { "ko": "터미널의 현재 폴더를 바꿔요. 파일은 건드리지 않아요.", "en": "Changes the terminal's current folder. No files are touched." }
        },
        {
          "id": "venv",
          "label": { "ko": "가상환경 켜기", "en": "Activate virtualenv" },
          "mode": "terminal",
          "cmd": "source ~/my-project/.venv/bin/activate",
          "risk": "danger",
          "confirm": { "ko": "이 터미널에서 가상환경을 켜요.", "en": "Activates the virtualenv in this terminal." }
        },
        {
          "id": "git-status",
          "label": { "ko": "git 상태 보기", "en": "Show git status" },
          "mode": "terminal",
          "cmd": "git -C ~/my-project status",
          "risk": "read"
        },
        {
          "id": "build",
          "label": { "ko": "빌드", "en": "Build" },
          "$comment": "Replace the build command with yours. 빌드 명령을 내 것으로 바꾸세요.",
          "mode": "terminal",
          "cmd": "cd ~/my-project && make",
          "risk": "change",
          "confirm": { "ko": "프로젝트 폴더에서 make를 실행해요. 파일이 새로 만들어질 수 있어요.", "en": "Runs make in the project folder. New files may be created." }
        }
      ]
    },
    {
      "id": "sensors",
      "title": { "ko": "센서", "en": "Sensors" },
      "desc": { "ko": "카메라·USB·I2C·시리얼 장치를 확인해요. 모두 보기만 해요.", "en": "Check cameras, USB, I2C and serial devices. View only." },
      "actions": [
        {
          "id": "video-nodes",
          "label": { "ko": "카메라 장치 파일", "en": "Camera device files" },
          "cmd": "ls /dev/video*",
          "risk": "read",
          "display": { "type": "text" }
        },
        {
          "id": "v4l2-devices",
          "label": { "ko": "카메라 목록 (v4l2)", "en": "Camera list (v4l2)" },
          "cmd": "v4l2-ctl --list-devices",
          "risk": "read",
          "display": { "type": "text" }
        },
        {
          "id": "usb",
          "label": { "ko": "USB 장치", "en": "USB devices" },
          "cmd": "lsusb",
          "risk": "read",
          "display": { "type": "text" }
        },
        {
          "id": "i2c-buses",
          "label": { "ko": "I2C 버스", "en": "I2C buses" },
          "cmd": "i2cdetect -l",
          "risk": "read",
          "display": { "type": "text" }
        },
        {
          "id": "tty",
          "label": { "ko": "시리얼 장치 (tty)", "en": "Serial devices (tty)" },
          "cmd": "ls /dev/ttyUSB* /dev/ttyACM*",
          "risk": "read",
          "display": { "type": "text" }
        },
        {
          "id": "dmesg",
          "label": { "ko": "커널 메시지 끝부분", "en": "Kernel messages (tail)" },
          "desc": { "ko": "장치를 꽂은 직후에 보면 인식 여부를 알 수 있어요.", "en": "Look right after plugging a device in to see whether it was detected." },
          "cmd": "dmesg | tail -n 30",
          "risk": "read",
          "display": { "type": "text" }
        }
      ]
    },
    {
      "id": "live",
      "title": { "ko": "실시간 보기", "en": "Live view" },
      "desc": { "ko": "끝나지 않는 출력을 실시간으로 보여 주는 템플릿이에요. 시작·멈춤을 누르고, 화면을 나가면 멈춰요.", "en": "Templates that show endless output live. Press Start and Stop; leaving the screen stops it." },
      "actions": [
        {
          "id": "follow-log",
          "$comment": "stream + a fixed-choice field + an int field. 스트림 + 고정 선택지 + 숫자 필드.",
          "label": { "ko": "서비스 로그 따라 보기", "en": "Follow a service log" },
          "mode": "stream",
          "cmd": "journalctl --no-pager -u {unit} -n {lines} -f",
          "risk": "read",
          "timeout": 900,
          "fields": [
            { "name": "unit", "label": { "ko": "서비스", "en": "Service" }, "type": "select", "choices": [
              { "value": "ssh", "label": { "ko": "ssh", "en": "ssh" } },
              { "value": "docker", "label": { "ko": "docker", "en": "docker" } }
            ] },
            { "name": "lines", "label": { "ko": "처음 줄 수", "en": "First lines" }, "type": "int", "min": 10, "max": 500, "default": "50" }
          ],
          "display": { "type": "log", "maxLines": 1000 }
        },
        {
          "id": "follow-train-log",
          "$comment": "tail -f of your own log file. 내 로그 파일을 tail -f로.",
          "label": { "ko": "학습 로그 따라 보기", "en": "Follow the training log" },
          "mode": "stream",
          "cmd": "tail -n {lines} -f ~/my-project/train.log",
          "risk": "read",
          "fields": [
            { "name": "lines", "label": { "ko": "처음 줄 수", "en": "First lines" }, "type": "int", "min": 10, "max": 500, "default": "50" }
          ],
          "display": { "type": "log", "maxLines": 2000 }
        },
        {
          "id": "topic-echo",
          "$comment": "A select whose choices are read from the Device (from). 기기에서 선택지를 불러오는 select(from).",
          "label": { "ko": "ROS2 토픽 보기", "en": "Watch a ROS2 topic" },
          "mode": "stream",
          "cmd": "ros2 topic echo {topic}",
          "risk": "read",
          "shell": "bash-i",
          "fields": [
            { "name": "topic", "label": { "ko": "토픽", "en": "Topic" }, "type": "select",
              "from": { "cmd": "ros2 topic list", "shell": "bash-i", "timeout": 15, "charset": "ros", "max": 200 } }
          ],
          "display": { "type": "log" }
        }
      ]
    },
    {
      "id": "charts",
      "title": { "ko": "그래프", "en": "Charts" },
      "desc": { "ko": "숫자를 시간에 따라 선 그래프로 그리는 템플릿이에요. 시작을 누르면 읽기 명령을 되풀이하고, 화면을 나가면 멈춰요.", "en": "Templates that plot numbers over time. Start runs a read-only command again and again; leaving the screen stops it." },
      "actions": [
        {
          "id": "temp-chart",
          "$comment": "match + perLine: one chart line per matching output line. match + perLine: 맞는 줄마다 선 하나.",
          "label": { "ko": "온도 그래프", "en": "Temperature chart" },
          "cmd": "grep -H . /sys/class/thermal/thermal_zone*/temp 2>/dev/null || true",
          "risk": "read",
          "display": { "type": "chart", "every": 2, "unit": "℃", "min": 0, "max": 100, "match": "thermal_zone(\\d+)/temp:(-?\\d+)$", "perLine": { "label": { "ko": "존 {1}", "en": "Zone {1}" }, "value": 2, "scale": 0.001 } }
        },
        {
          "id": "mem-chart",
          "$comment": "match + series with key: pick named values (the match needs exactly 2 groups). match + series(key): 이름으로 값 고르기(묶음 정확히 2개).",
          "label": { "ko": "메모리 그래프", "en": "Memory chart" },
          "cmd": "grep -E '^(MemTotal|MemAvailable):' /proc/meminfo",
          "risk": "read",
          "display": { "type": "chart", "every": 2, "unit": "MB", "min": 0, "match": "^(\\w+):\\s+(\\d+) kB$", "series": [
            { "label": { "ko": "전체", "en": "Total" }, "key": "MemTotal", "scale": 0.0009765625 },
            { "label": { "ko": "쓸 수 있음", "en": "Available" }, "key": "MemAvailable", "scale": 0.0009765625 }
          ] }
        },
        {
          "id": "load-chart",
          "$comment": "split + series with col: columns of one line. split + series(col): 한 줄의 칸.",
          "label": { "ko": "부하 평균 그래프", "en": "Load average chart" },
          "cmd": "cat /proc/loadavg",
          "risk": "read",
          "display": { "type": "chart", "every": 2, "min": 0, "split": "ws", "series": [
            { "label": { "ko": "1분", "en": "1 min" }, "col": 1 },
            { "label": { "ko": "5분", "en": "5 min" }, "col": 2 },
            { "label": { "ko": "15분", "en": "15 min" }, "col": 3 }
          ] }
        },
        {
          "id": "train-loss-chart",
          "$comment": "Your own log: the last line must contain loss=1.234. Change the file name and the expression. 내 로그: 마지막 줄에 loss=1.234 가 있어야 해요. 파일 이름과 식을 바꾸세요.",
          "label": { "ko": "학습 loss 그래프", "en": "Training loss chart" },
          "cmd": "tail -n 1 ~/my-project/train.log",
          "risk": "read",
          "display": { "type": "chart", "every": 5, "match": "loss=(\\d+\\.?\\d*)", "perLine": { "label": { "ko": "loss", "en": "loss" }, "value": 1 } }
        }
      ]
    },
    {
      "id": "training",
      "title": { "ko": "학습 작업", "en": "Training job" },
      "desc": { "ko": "학습 스크립트 템플릿이에요. train.py 와 ~/my-project 를 내 것으로 바꾸세요.", "en": "Training-script templates. Replace train.py and ~/my-project with your own." },
      "actions": [
        {
          "id": "train-start",
          "label": { "ko": "학습 시작", "en": "Start training" },
          "mode": "terminal",
          "cmd": "cd ~/my-project && python train.py --epochs 10 2>&1 | tee train.log",
          "risk": "change",
          "confirm": { "ko": "학습을 시작해요. GPU와 시간을 오래 써요.", "en": "Starts training. This uses the GPU for a long time." }
        },
        {
          "id": "train-log",
          "label": { "ko": "로그 마지막 50줄", "en": "Last 50 log lines" },
          "cmd": "tail -n 50 ~/my-project/train.log",
          "risk": "read",
          "display": { "type": "text" }
        },
        {
          "id": "train-stop",
          "label": { "ko": "학습 중단", "en": "Stop training" },
          "mode": "terminal",
          "cmd": "pkill -f train.py",
          "risk": "danger",
          "confirm": { "ko": "train.py 를 실행 중인 프로세스를 모두 끝내요. 저장하지 않은 학습 결과는 사라져요.", "en": "Ends every process running train.py. Unsaved training progress is lost." }
        }
      ]
    }
  ],
  "badges": [
    {
      "id": "script-files",
      "label": { "ko": "스크립트 파일 표시", "en": "Mark script files" },
      "cmd": "ls -1A {dir}",
      "match": "^(.+\\.(py|sh))$",
      "code": 2,
      "path": 1,
      "codes": {
        "py": { "show": "py", "text": { "ko": "파이썬 파일", "en": "Python file" }, "tone": "info" },
        "sh": { "show": "sh", "text": { "ko": "셸 스크립트", "en": "Shell script" }, "tone": "dim" }
      },
      "folderDot": false
    }
  ]
}
