{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawnilove.github.io/JetDeck/packs/index.schema.json",
  "title": "JetDeck gallery index (format 1)",
  "description": "Reference for index.json. The app is the real validator (it also checks the signature, serial and expiry first). 앱이 실제 검사기예요.",
  "type": "object",
  "required": ["format", "serial", "generatedAt", "expires", "packs"],
  "properties": {
    "format": { "const": 1 },
    "serial": { "type": "integer", "minimum": 0, "description": "Raised on every publish. The app rejects a lower value than it has seen." },
    "generatedAt": { "type": "string", "format": "date-time" },
    "expires": { "type": "string", "format": "date-time", "description": "4 years after generatedAt. After this the list is shown but new installs are blocked." },
    "packs": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/pack" }, "description": "One version per pack id." },
    "revoked": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/revoked" } }
  },
  "$defs": {
    "text": { "type": "object", "required": ["ko", "en"], "properties": { "ko": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } } },
    "pack": {
      "type": "object",
      "required": ["id", "version", "name", "desc", "license", "tier", "file", "sha256", "size", "caps", "reviewedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,39}$" },
        "version": { "type": "string", "pattern": "^\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?$" },
        "name": { "allOf": [{ "$ref": "#/$defs/text" }], "description": "Max 60 characters per language." },
        "desc": { "allOf": [{ "$ref": "#/$defs/text" }], "description": "Max 300 characters per language." },
        "author": { "type": "string", "maxLength": 100, "description": "Self-declared by the pack." },
        "submitter": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$", "description": "GitHub account that submitted the pack (checked by the maintainer)." },
        "license": { "type": "string", "maxLength": 60 },
        "tier": { "const": "reviewed" },
        "minApp": { "type": "string", "pattern": "^\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?$" },
        "file": { "type": "string", "pattern": "^files/[a-z][a-z0-9-]{2,39}/\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?/[a-z][a-z0-9-]{2,39}\.jdpack\.json$", "description": "Relative path only. Must equal files/<id>/<version>/<id>.jdpack.json." },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 131072 },
        "caps": {
          "type": "object",
          "required": ["read", "change", "danger", "stream", "form", "chart", "badge", "autoRun"],
          "properties": {
            "read": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "change": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "danger": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "stream": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "form": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "chart": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "badge": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "autoRun": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "perms": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 40 } }
          },
          "description": "Counts for the list only. The app recomputes them from the downloaded file."
        },
        "tags": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 20 } },
        "reviewedAt": { "type": "string" }
      }
    },
    "revoked": {
      "type": "object",
      "required": ["id", "reason", "at"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,39}$" },
        "version": { "type": "string", "description": "Omit to withdraw every version of the id." },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "reason": { "allOf": [{ "$ref": "#/$defs/text" }], "description": "Max 300 characters per language." },
        "at": { "type": "string" }
      }
    }
  }
}
