{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dawnilove.github.io/JetDeck/plugins/jdpack.schema.json",
  "title": "JetDeck pack (format 1)",
  "description": "A JetDeck declarative plugin pack. See format.md. JetDeck still validates every pack itself and computes the real risk; this schema is for editor help only.",
  "type": "object",
  "required": ["id", "format", "version", "name", "plugins"],
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$", "not": { "enum": ["device", "ros2", "monitor", "perf", "examples", "ros2-live", "jetdeck", "official", "app", "core", "snippets"] }, "description": "Lower-case letters, digits and '-'. Reserved names and names starting with 'jetdeck-' are refused." },
    "format": { "const": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "name": { "$ref": "#/definitions/text60" },
    "desc": { "$ref": "#/definitions/text300" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "homepage": { "type": "string" },
    "minApp": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "plugins": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/definitions/plugin" } }
  },
  "definitions": {
    "text": {
      "oneOf": [
        { "type": "string" },
        { "type": "object", "properties": { "ko": { "type": "string" }, "en": { "type": "string" } }, "minProperties": 1 }
      ]
    },
    "text60": { "$ref": "#/definitions/text", "description": "Plain text or { ko, en }. Max 60 characters." },
    "text300": { "$ref": "#/definitions/text", "description": "Plain text or { ko, en }. Max 300 characters." },
    "text500": { "$ref": "#/definitions/text", "description": "Plain text or { ko, en }. Max 500 characters." },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
    "plugin": {
      "type": "object",
      "required": ["id", "title", "actions"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "$ref": "#/definitions/text60" },
        "desc": { "$ref": "#/definitions/text300" },
        "icon": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,29}$" },
        "actions": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/definitions/action" } }
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "label", "cmd", "risk"],
      "properties": {
        "$comment": { "type": "string" },
        "id": { "$ref": "#/definitions/id" },
        "label": { "$ref": "#/definitions/text60" },
        "desc": { "$ref": "#/definitions/text300" },
        "cmd": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "Do not write sudo; use \"sudo\": true. {name} is replaced by a choice from params." },
        "risk": { "enum": ["read", "change", "danger"], "description": "What you claim. JetDeck computes the real risk and uses the higher one." },
        "mode": { "enum": ["exec", "terminal", "stream"], "default": "exec", "description": "stream (5.1.0, needs minApp 5.1.0): output that keeps coming, shown live with display.type log." },
        "enter": { "type": "boolean", "default": true },
        "sudo": { "type": "boolean" },
        "confirm": { "$ref": "#/definitions/text500" },
        "preview": { "type": "string" },
        "params": { "type": "array", "items": { "$ref": "#/definitions/param" }, "description": "Fixed choices. Use either params or fields, not both." },
        "fields": { "type": "array", "maxItems": 6, "items": { "$ref": "#/definitions/field" }, "description": "Input form (5.1.0, needs minApp 5.1.0). Each name fills the {name} slot in cmd." },
        "auto": { "type": "boolean" },
        "display": { "$ref": "#/definitions/display" },
        "timeout": { "type": "number", "minimum": 1, "maximum": 3600, "description": "Seconds. exec: default 60, max 600. stream: the longest it may run, default 600, max 3600." },
        "disconnects": { "type": "boolean" },
        "shell": { "enum": ["sh", "bash-i"], "default": "sh" },
        "when": { "const": "jetson" }
      }
    },
    "param": {
      "type": "object",
      "required": ["name", "label", "choices"],
      "properties": {
        "name": { "type": "string", "pattern": "^\\w+$" },
        "label": { "$ref": "#/definitions/text60" },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string", "maxLength": 100, "pattern": "^[A-Za-z0-9_.@:~/+][A-Za-z0-9_.@:~/+-]*$" },
              "label": { "$ref": "#/definitions/text60" }
            }
          }
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["name", "label", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^\\w+$" },
        "label": { "$ref": "#/definitions/text60" },
        "desc": { "$ref": "#/definitions/text300" },
        "type": { "enum": ["select", "text", "int", "path", "flag"] },
        "required": { "type": "boolean", "default": true },
        "default": { "type": ["string", "boolean"], "description": "A string (for int too, for example \"50\"); a boolean for flag." },
        "choices": { "type": "array", "minItems": 1, "maxItems": 30, "description": "select: fixed choices, same as params.", "items": { "type": "object", "required": ["value", "label"], "properties": { "value": { "type": "string", "maxLength": 100, "pattern": "^[A-Za-z0-9_.@:~/+][A-Za-z0-9_.@:~/+-]*$" }, "label": { "$ref": "#/definitions/text60" } } } },
        "from": {
          "type": "object",
          "required": ["cmd"],
          "description": "select: choices read from the Device. The command must be read-only. It runs when the screen opens.",
          "properties": {
            "cmd": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "shell": { "enum": ["sh", "bash-i"], "default": "sh" },
            "timeout": { "type": "number", "minimum": 1, "maximum": 15, "default": 15 },
            "charset": { "enum": ["word", "ros", "path"], "default": "word" },
            "max": { "type": "integer", "minimum": 1, "maximum": 200, "default": 200 }
          }
        },
        "charset": { "enum": ["word", "ros", "free"], "default": "word", "description": "text only." },
        "maxLen": { "type": "integer", "minimum": 1, "maximum": 300, "description": "text: max 200, default 60. path: max 300, default 300." },
        "min": { "type": "integer", "minimum": 0, "maximum": 1000000, "description": "int only." },
        "max": { "type": "integer", "minimum": 0, "maximum": 1000000, "description": "int only." },
        "on": { "type": "string", "pattern": "^[A-Za-z0-9_.=-]{1,40}$", "description": "flag only: the text inserted when the box is checked." }
      }
    },
    "display": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["text", "table", "log"] },
        "maxLines": { "type": "integer", "minimum": 100, "maximum": 5000, "description": "log only: lines kept on screen. Default 1000." },
        "match": { "type": "string", "maxLength": 200 },
        "split": { "enum": ["ws", "tab"] },
        "skip": { "type": "integer", "minimum": 0 },
        "columns": { "type": "array", "maxItems": 20, "items": { "$ref": "#/definitions/text60" } },
        "empty": { "$ref": "#/definitions/text300" },
        "labels": { "type": "object", "additionalProperties": { "$ref": "#/definitions/text60" } }
      }
    }
  }
}
