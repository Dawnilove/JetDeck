    "rules": [
      {
        "token": "comment",
        "foreground": "8296B6",
        "fontStyle": "italic"
      },
      {
        "token": "keyword",
        "foreground": "C792EA",
        "fontStyle": "bold"
      },
      {
        "token": "string",
        "foreground": "C3E88D"
      },
      {
        "token": "number",
        "foreground": "F78C6C"
      },
      {
        "token": "function",
        "foreground": "82AAFF"
      },
      {
        "token": "tag",
        "foreground": "C792EA"
      },
      {
        "token": "metatag",
        "foreground": "C792EA"
      },
      {
        "token": "attribute.name",
        "foreground": "82AAFF"
      },
      {
        "token": "attribute.value",
        "foreground": "C3E88D"
      },
      {
        "token": "regexp",
        "foreground": "F78C6C"
      },
      {
        "token": "string.escape",
        "foreground": "F78C6C"
      },
      {
        "token": "predefined",
        "foreground": "82AAFF"
      }
    ]
  },
  "shape": {
    "radiusWindow": 12,
    "radiusSmall": 8,
    "radiusInput": 8,
    "radiusButton": 8,
    "buttonShadow": "none"
  },
  "font": {
    "ui": "'IBM Plex Sans KR', sans-serif",
    "display": "'IBM Plex Sans KR', sans-serif",
    "mono": "'JetBrains Mono', 'IBM Plex Sans KR', monospace"
  }
}
