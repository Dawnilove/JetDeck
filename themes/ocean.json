      "brightBlack": "#9AAECB",
      "brightRed": "#FFA3AD",
      "brightGreen": "#8EE9BC",
      "brightYellow": "#FFDB97",
      "brightBlue": "#A8C4FF",
      "brightMagenta": "#D8B3F0",
      "brightCyan": "#84D5F9",
      "brightWhite": "#FFFFFF"
