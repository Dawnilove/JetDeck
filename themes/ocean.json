  },
  "editor": {
    "monacoBase": "vs-dark",
    "colors": {
      "editor.background": "#0B1526",
      "editor.foreground": "#D5E2F3",
      "editorLineNumber.foreground": "#536C94",
      "editorLineNumber.activeForeground": "#E3ECF8",
      "editor.lineHighlightBackground": "#112038",
      "editor.selectionBackground": "#1C3254",
      "editorCursor.foreground": "#4FC3F7",
      "editorGutter.background": "#0B1526",
      "minimap.background": "#0B1526",
      "editor.inactiveSelectionBackground": "#1C325499",
      "editorIndentGuide.background1": "#1C3254",
      "editorIndentGuide.activeBackground1": "#4A6FA3",
      "editorWhitespace.foreground": "#1C3254",
      "editorBracketMatch.background": "#1C325480",
      "editorBracketMatch.border": "#4A6FA3",
      "editor.findMatchBackground": "#FFCB6B66",
      "editor.findMatchHighlightBackground": "#FFCB6B33",
      "editorWidget.background": "#112038",
      "editorWidget.border": "#1C3254",
      "editorSuggestWidget.background": "#112038",
      "editorSuggestWidget.border": "#1C3254",
      "editorSuggestWidget.foreground": "#E3ECF8",
      "editorSuggestWidget.selectedBackground": "#1C3254",
      "editorSuggestWidget.highlightForeground": "#4FC3F7",
      "editorHoverWidget.background": "#112038",
      "editorHoverWidget.border": "#1C3254",
      "scrollbarSlider.background": "#9AAECB33",
      "scrollbarSlider.hoverBackground": "#9AAECB55",
      "scrollbarSlider.activeBackground": "#9AAECB77"
