      {
        "token": "metatag",
        "foreground": "A8501A"
      },
      {
        "token": "attribute.name",
        "foreground": "6E4A38"
      },
      {
        "token": "attribute.value",
        "foreground": "2D7B5A"
      },
      {
        "token": "regexp",
        "foreground": "B03A4E"
      },
      {
        "token": "string.escape",
        "foreground": "B03A4E"
      },
      {
        "token": "predefined",
        "foreground": "6E4A38"
      },
      {
        "token": "key",
        "foreground": "1C6E80"
      }
    ]
  },
